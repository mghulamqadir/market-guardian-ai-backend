{
  "name": "market-guardian-ai-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env index.js",
    "dev": "node --watch --env-file=.env index.js",
    "db:migrate": "node --env-file=.env node_modules/sequelize-cli/lib/sequelize --options-path .sequelizerc.cjs db:migrate",
    "db:migrate:undo": "node --env-file=.env node_modules/sequelize-cli/lib/sequelize --options-path .sequelizerc.cjs db:migrate:undo",
    "db:migrate:undo:all": "node --env-file=.env node_modules/sequelize-cli/lib/sequelize --options-path .sequelizerc.cjs db:migrate:undo:all",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/sequelize": "^4.1.0",
    "@aws-sdk/client-lambda": "^3.965.0",
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/credential-providers": "^3.965.0",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sharp": "^0.34.5",
    "sib-api-v3-sdk": "^8.5.0",
    "streamifier": "^0.1.1",
    "stripe": "^20.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "ws": "^8.19.0"
  },
  "overrides": {
    "tinymce": "7.2.0",
    "@tiptap/extension-link": ">=2.10.4",
    "fast-xml-parser": "^5.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "sequelize-cli": "^6.6.2"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  },
  "homepage": "https://github.com/mghulamqadir/market-guardian-ai-backend#readme",
  "bugs": {
    "url": "https://github.com/mghulamqadir/market-guardian-ai-backend/issues"
  },
  "packageManager": "pnpm@10.21.0+sha512.da3337267e400fdd3d479a6c68079ac6db01d8ca4f67572083e722775a796788a7a9956613749e000fac20d424b594f7a791a5f4e2e13581c5ef947f26968a40"
}
